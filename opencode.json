{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "indian-rail": {
      "type": "local",
      "command": ["npx", "-y", "indian-rail-mcp@0.1.1"],
      "enabled": true,
      "timeout": 30000
    },
    "brightdata": {
      "type": "remote",
      "url": "https://mcp.brightdata.com/mcp?token={env:BRIGHTDATA_API_TOKEN}",
      "enabled": true
    }
  }
}
